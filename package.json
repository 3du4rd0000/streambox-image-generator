{
  "name": "streambox-image-generator",
  "version": "1.0.0",
  "description": "Sirve las imágenes de SstreamBoxx (equipos, ligas, doodles, marca) y genera imágenes de resultados con Canvas",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "optionalDependencies": {
    "canvas": "^2.11.2",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}